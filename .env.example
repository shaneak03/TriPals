# Copy to .env.local and fill in. Never commit real values.

# Public: safe in the browser (read-only via Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (API routes for journey search). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DUFFEL_API_TOKEN=
