# Copy to .env and fill in. Never commit real values.
# The service role key bypasses Row Level Security; it stays on this server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cities to load (comma-separated ids from the Supabase cities table). Empty = every
# active city. Measured: Milan alone idles at ~210 MB; Milan + Paris + Barcelona idle at
# ~375 MB and peaked at ~410 MB while routing, so all three fit a 512 MB server.
ROUTING_CITIES=

# Browser origins allowed to call the API (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000

# Optional: where OSM downloads and scored graphs are cached (default: <repo>/.cache/walkroute).
# WALKROUTE_CACHE_DIR=
